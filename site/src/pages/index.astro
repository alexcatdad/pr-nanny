---
const base = `${import.meta.env.BASE_URL}/`;
const releases = 'https://github.com/alexcatdad/pr-nanny/releases';
const source = 'https://github.com/alexcatdad/pr-nanny';
const contributing = `${source}/blob/main/CONTRIBUTING.md`;
const changelog = releases;
const title = 'PR Nanny — Your pull requests, quietly in view';
const description = 'A small native tray app for authored PRs and reviews waiting on you. Read-only, local, and open source.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="canonical" href="https://alexcatdad.github.io/pr-nanny/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PR Nanny" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://alexcatdad.github.io/pr-nanny/" />
    <meta property="og:image" content="https://alexcatdad.github.io/pr-nanny/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://alexcatdad.github.io/pr-nanny/og.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}`} aria-label="PR Nanny home">
        <img src={`${base}icon.png`} width="30" height="30" alt="" />
        <span>PR Nanny</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a href={source} target="_blank" rel="noreferrer">Source</a>
        <a class="nav-cta" href={releases} target="_blank" rel="noreferrer">View releases</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Your pull requests,<br />quietly in view.</h1>
          <p class="hero-lede">A small native tray app for authored PRs and reviews waiting on you.</p>
          <p class="platform-note">macOS 13+ <span aria-hidden="true">·</span> Windows 10/11 <span aria-hidden="true">·</span> Linux x64</p>
          <p class="quiet-note">Notifications are local. PR bells start off.</p>
          <a class="text-link" href={releases} target="_blank" rel="noreferrer">Explore qualified releases <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="product-shot">
          <picture>
            <source srcset={`${base}screenshots/popup-dark-tabs.png`} media="(prefers-color-scheme: dark)" />
            <img src={`${base}screenshots/popup-light-tabs.png`} width="460" height="420" alt="PR Nanny showing authored pull requests grouped into Yours, Review, and Recent tabs, with approval and CI status." fetchpriority="high" />
          </picture>
          <figcaption>At a glance from the system tray</figcaption>
        </figure>
      </section>

      <section class="features" id="features" aria-label="What PR Nanny does">
        <div class="feature-visual" aria-hidden="true">
          <div class="mini-window">
            <div class="window-controls"><i></i><i></i><i></i></div>
            <div class="mini-row"><span class="mini-mark">✓</span><span>Authored by you</span></div>
            <div class="mini-row"><span class="mini-mark">↗</span><span>Reviews for you</span></div>
          <div class="mini-row"><span class="mini-mark">≡</span><span>Your open PRs</span></div>
          </div>
        </div>
        <div class="feature-copy">
          <h2>See the work you own</h2>
          <p>Keep track of authored pull requests, individual reviews, and team review requests in one simple view.</p>
        </div>
        <div class="feature-divider" aria-hidden="true"></div>
        <div class="privacy-copy" id="privacy">
          <h2>A read-only view of GitHub</h2>
          <p>PR Nanny reads pull request data and checks. It never writes to GitHub, changes subscriptions, or sends data to analytics.</p>
          <p>Your current PR data stays in memory on your machine.</p>
        </div>
        <figure class="mobile-shot">
          <picture>
            <source srcset={`${base}screenshots/popup-dark-tabs.png`} media="(prefers-color-scheme: dark)" />
            <img src={`${base}screenshots/popup-light-tabs.png`} width="460" height="420" loading="lazy" alt="PR Nanny with the Tabs view selected, showing pull requests grouped into tabs." />
          </picture>
          <figcaption>Show all or group by Tabs</figcaption>
        </figure>
      </section>

      <section class="release-info" id="releases" aria-labelledby="release-title">
        <div class="release-heading">
          <h2 id="release-title">A qualified prerelease for your desktop</h2>
          <a class="text-link" href={releases} target="_blank" rel="noreferrer">Browse releases <span aria-hidden="true">↗</span></a>
        </div>
        <div class="platforms">
          <article>
            <h3>macOS</h3>
            <p>macOS 13 or newer on Apple Silicon. Unzip the download and move <code>PR Nanny.app</code> to Applications.</p>
            <p>The app is ad-hoc signed for bundle integrity, but is not Developer ID signed or notarized. macOS may ask you to approve opening it.</p>
          </article>
          <article>
            <h3>Windows</h3>
            <p>Windows 10/11 x64 with Microsoft Edge WebView2 Runtime. Unzip the archive and run <code>install.ps1</code> to add a Start Menu shortcut for your account.</p>
            <p>The executable is unsigned and may prompt for confirmation.</p>
          </article>
          <article>
            <h3>Linux</h3>
            <p>Linux x64 with glibc 2.39+, GTK4, WebKitGTK 6, and a Secret Service-compatible credential store enabled.</p>
            <p>Run <code>./install.sh</code> from the extracted archive directory and make sure <code>~/.local/bin</code> is on your <code>PATH</code>.</p>
          </article>
        </div>
        <p class="release-footnote">Build availability and checksums are listed with each release. Individual platform builds do not establish qualification for the other platforms.</p>
      </section>

      <section class="brew-install" aria-labelledby="brew-title">
        <div>
          <p class="eyebrow">Homebrew</p>
          <h2 id="brew-title">Install from the tap</h2>
          <p>Install from the existing <a href="https://github.com/alexcatdad/homebrew-tap" target="_blank" rel="noreferrer">alexcatdad/tap</a>, with reviewed release checksums for each platform.</p>
          <p class="brew-note">macOS ARM64 uses the cask. Linux x64 uses the formula. Homebrew on Windows installs the Linux app in WSL; use the Windows ZIP for a native Windows install.</p>
        </div>
        <div class="brew-commands" aria-label="Homebrew installation commands">
          <p><span>macOS · Apple Silicon</span><code>brew tap alexcatdad/tap<br />brew install --cask alexcatdad/tap/pr-nanny</code></p>
          <p><span>Linux · x64</span><code>brew tap alexcatdad/tap<br />brew install alexcatdad/tap/pr-nanny</code></p>
        </div>
        <a class="text-link" href="https://github.com/alexcatdad/pr-nanny/blob/main/build/README.md" target="_blank" rel="noreferrer">Read Homebrew installation notes <span aria-hidden="true">↗</span></a>
      </section>

      <section class="details" aria-label="Product details">
        <p><strong>Native notifications</strong><span>Review requests can notify you. Other changes need a PR bell, which starts off.</span></p>
        <p><strong>One glance, your way</strong><span>Use Show all for one list or Tabs to group your authored, review-requested, and recently closed PRs.</span></p>
        <p><strong>Small and open source</strong><span>Runs in your system tray. Inspect the code, report an issue, or contribute on GitHub.</span></p>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href={`${base}`} aria-label="PR Nanny home">
        <img src={`${base}icon.png`} width="25" height="25" alt="" />
        <span>PR Nanny</span>
      </a>
      <nav aria-label="Footer navigation">
        <a href={source} target="_blank" rel="noreferrer">Source</a>
        <a href={releases} target="_blank" rel="noreferrer">Releases</a>
        <a href={changelog} target="_blank" rel="noreferrer">Changelog</a>
        <a href={contributing} target="_blank" rel="noreferrer">Contributing</a>
        <a href={`${source}/blob/main/SECURITY.md`} target="_blank" rel="noreferrer">Security</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 5rem; }
  :global(body) {
    --ink: #121820;
    --muted: #5f6b79;
    --soft: #748092;
    --rule: #dce2e9;
    --accent: #1769e8;
    --link: #1769e8;
    --paper: #fff;
    --surface: #f6f8fa;
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 3px solid var(--link); outline-offset: 4px; border-radius: 2px; }
  .site-header, .site-footer {
    min-height: 74px;
    width: min(100% - 64px, 1392px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-header { border-bottom: 1px solid var(--rule); }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 1.06rem; font-weight: 680; letter-spacing: -.04em; }
  .brand img { display: block; object-fit: contain; }
  nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 42px); }
  nav a { color: var(--muted); font-size: .92rem; transition: color 150ms ease; }
  nav a:hover, .text-link:hover { color: var(--link); }
  .site-header nav .nav-cta { color: #fff; background: var(--accent); border-radius: 5px; padding: 10px 17px; font-weight: 620; }
  .nav-cta:hover { color: #fff; background: #0e58ca; }
  main { width: min(100% - 64px, 1392px); margin-inline: auto; }
  .hero { display: grid; grid-template-columns: minmax(320px, 1.05fr) minmax(430px, .95fr); gap: clamp(48px, 6vw, 84px); align-items: center; padding: clamp(58px, 8vw, 106px) 0 90px; }
  .hero-copy { max-width: 680px; padding-left: clamp(0px, 1vw, 12px); }
  h1, h2, p, figure { margin: 0; }
  h1 { font-size: clamp(3.25rem, 4.75vw, 5.25rem); line-height: .99; letter-spacing: -.072em; font-weight: 720; }
  .hero-lede { margin-top: 26px; color: var(--muted); max-width: 450px; font-size: clamp(1.2rem, 2vw, 1.55rem); line-height: 1.42; letter-spacing: -.025em; }
  .platform-note { margin-top: 52px; font-size: .94rem; color: var(--muted); }
  .platform-note span { padding-inline: 4px; color: #a1aab5; }
  .quiet-note { margin-top: 2px; color: var(--soft); font-size: .9rem; }
  .text-link { display: inline-flex; gap: 8px; margin-top: 24px; color: var(--link); font-size: .96rem; font-weight: 640; }
  .product-shot { justify-self: end; width: min(100%, 520px); }
  .product-shot img { display: block; width: 100%; height: auto; border: 1px solid #d7dce3; border-radius: 13px; box-shadow: 0 20px 55px rgb(19 29 43 / 12%); }
  figcaption { margin-top: 12px; color: var(--soft); font-size: .78rem; }
  .features { display: grid; grid-template-columns: .76fr 1.1fr 1px 1.1fr .82fr; gap: clamp(22px, 3vw, 46px); align-items: center; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 48px 8px; }
  .feature-copy, .privacy-copy { align-self: center; }
  h2 { font-size: clamp(1.48rem, 2.1vw, 2rem); line-height: 1.14; letter-spacing: -.05em; font-weight: 690; }
  .feature-copy p, .privacy-copy p { margin-top: 17px; color: var(--muted); font-size: clamp(1rem, 1.3vw, 1.18rem); line-height: 1.6; }
  .privacy-copy p + p { margin-top: 10px; }
  .feature-divider { width: 1px; height: 100%; min-height: 170px; background: var(--rule); }
  .mini-window { border: 1px solid #d7dce3; border-radius: 9px; overflow: hidden; color: #26303b; background: #fff; box-shadow: 0 8px 24px rgb(20 29 43 / 7%); }
  .window-controls { height: 38px; border-bottom: 1px solid #e0e4e9; display: flex; align-items: center; gap: 6px; padding-inline: 12px; }
  .window-controls i { width: 10px; height: 10px; border-radius: 50%; background: #ff625a; }
  .window-controls i:nth-child(2) { background: #ffbd44; }
  .window-controls i:nth-child(3) { background: #00ca4e; }
  .mini-row { min-height: 47px; display: grid; grid-template-columns: 22px 1fr; gap: 6px; align-items: center; padding: 0 12px; font-size: .82rem; border-bottom: 1px solid #e9edf1; }
  .mini-row:last-child { border-bottom: 0; }
  .mini-mark { color: var(--accent); font-size: 1rem; }
  .mobile-shot { width: min(100%, 210px); justify-self: end; }
  .mobile-shot img { display: block; width: 100%; height: auto; border: 1px solid #d7dce3; border-radius: 16px; box-shadow: 0 12px 34px rgb(19 29 43 / 10%); }
  .details { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(22px, 4vw, 62px); padding: 62px 12px 70px; }
  .details p { display: grid; gap: 7px; align-content: start; }
  .details strong { font-size: .98rem; font-weight: 660; letter-spacing: -.015em; }
  .details span { color: var(--muted); font-size: .91rem; line-height: 1.55; }
  .release-info { padding: 55px 12px 10px; }
  .release-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--rule); }
  .release-heading h2 { font-size: clamp(1.6rem, 2.5vw, 2.25rem); }
  .release-heading .text-link { margin-top: 0; white-space: nowrap; }
  .platforms { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(22px, 4vw, 62px); padding-top: 27px; }
  .platforms article { padding-right: clamp(0px, 2vw, 28px); }
  .platforms article + article { border-left: 1px solid var(--rule); padding-left: clamp(22px, 3vw, 42px); }
  .platforms h3 { margin: 0; font-size: 1.04rem; font-weight: 670; }
  .platforms p { margin-top: 10px; color: var(--muted); font-size: .9rem; line-height: 1.55; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .86em; color: var(--ink); }
  .release-footnote { border-top: 1px solid var(--rule); margin-top: 25px; padding-top: 14px; color: var(--soft); font-size: .82rem; }
  .brew-install { display: grid; grid-template-columns: minmax(0, 1fr) minmax(350px, .9fr); gap: 18px 48px; align-items: start; margin: 48px 12px 0; padding: 28px; border: 1px solid var(--rule); border-radius: 15px; background: var(--surface); }
  .brew-install .eyebrow { margin: 0 0 8px; color: var(--link); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .brew-install h2 { margin-bottom: 10px; font-size: 1.5rem; }
  .brew-install p { margin: 0; color: var(--soft); font-size: .92rem; line-height: 1.6; }
  .brew-install a:not(.text-link) { color: var(--link); text-underline-offset: 3px; }
  .brew-install .brew-note { margin-top: 10px; font-size: .82rem; }
  .brew-commands { display: grid; gap: 10px; }
  .brew-commands p { display: grid; gap: 6px; }
  .brew-commands span { color: var(--soft); font-size: .76rem; font-weight: 650; }
  .brew-commands code { display: block; padding: 11px 13px; border: 1px solid var(--rule); border-radius: 9px; background: var(--surface); color: var(--ink); font-size: .78rem; line-height: 1.75; overflow-wrap: anywhere; }
  .brew-install > .text-link { grid-column: 1 / -1; margin-top: 0; }
  .site-footer { min-height: 84px; border-top: 1px solid var(--rule); }
  .site-footer nav { gap: clamp(15px, 2.4vw, 34px); }
  .site-footer nav a { font-size: .84rem; }
  @media (prefers-color-scheme: dark) {
    :global(body) { --ink: #f0f3f7; --muted: #b4bfcc; --soft: #929eac; --rule: #303944; --paper: #11161c; --surface: #171d25; --link: #79b4ff; }
    .brand img { filter: drop-shadow(0 0 1px #fff); }
    .product-shot img, .mobile-shot img { border-color: #303944; box-shadow: 0 20px 55px rgb(0 0 0 / 32%); }
    .mini-window { border-color: #303944; color: #d7dfe9; background: #171d25; }
    .window-controls, .mini-row { border-color: #303944; }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(260px, .9fr) minmax(340px, 1.1fr); gap: 36px; padding-block: 66px; }
    .features { grid-template-columns: .75fr 1.2fr 1px 1.2fr; }
    .mobile-shot { display: none; }
    h1 { font-size: clamp(3rem, 6vw, 4.6rem); }
  }
  @media (min-width: 661px) and (max-width: 699px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .product-shot { width: min(100%, 480px); justify-self: center; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .hero { grid-template-columns: minmax(390px, 1fr) minmax(360px, 1fr); gap: 32px; }
    .product-shot { width: min(100%, 440px); }
  }
  @media (max-width: 660px) {
    .site-header, .site-footer { width: min(100% - 36px, 1392px); }
    main { width: min(100% - 36px, 1392px); }
    .site-header { min-height: 66px; }
    .site-header nav { gap: 13px; }
    .site-header nav a { font-size: .8rem; }
    .site-header nav a:nth-child(1), .site-header nav a:nth-child(3) { display: none; }
    .nav-cta { padding: 8px 11px; }
    .brand { font-size: .98rem; gap: 7px; }
    .hero { display: flex; flex-direction: column; align-items: stretch; gap: 36px; padding: 54px 0 58px; }
    .hero-copy { max-width: none; padding: 0; }
    h1 { font-size: clamp(3.15rem, 13vw, 4.7rem); }
    .hero-lede { margin-top: 20px; font-size: 1.2rem; }
    .platform-note { margin-top: 28px; font-size: .83rem; }
    .quiet-note { font-size: .82rem; }
    .product-shot { width: min(100%, 400px); align-self: center; }
    .features { grid-template-columns: minmax(110px, .7fr) minmax(0, 1.3fr); gap: 25px 16px; padding: 34px 0; }
    .feature-visual { grid-column: 1; }
    .feature-copy { grid-column: 2; }
    .feature-divider { display: none; }
    .privacy-copy { grid-column: 1 / -1; padding-top: 10px; }
    .mobile-shot { display: none; }
    .mini-row { min-height: 44px; font-size: .68rem; padding-inline: 8px; grid-template-columns: 16px 1fr; gap: 3px; }
    .window-controls { height: 32px; }
    h2 { font-size: 1.34rem; }
    .feature-copy p, .privacy-copy p { margin-top: 10px; font-size: .95rem; }
    .release-info { padding: 40px 2px 5px; }
    .brew-install { grid-template-columns: 1fr; gap: 18px; margin: 35px 2px 0; padding: 20px; }
    .brew-install > .text-link { grid-column: auto; }
    .release-heading { align-items: flex-start; flex-direction: column; gap: 12px; }
    .platforms { grid-template-columns: 1fr; gap: 22px; padding-top: 22px; }
    .platforms article { padding-right: 0; }
    .platforms article + article { border-left: 0; border-top: 1px solid var(--rule); padding: 19px 0 0; }
    .details { grid-template-columns: 1fr; gap: 24px; padding: 40px 2px 48px; }
    .details p { gap: 2px; }
    .site-footer { min-height: 0; padding: 24px 0; align-items: flex-start; gap: 22px; flex-direction: column; }
    .site-footer nav { flex-wrap: wrap; gap: 12px 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    nav a { transition: none; }
  }
</style>
