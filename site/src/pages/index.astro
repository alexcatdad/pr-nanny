---
const base = `${import.meta.env.BASE_URL}/`.replace(/\/+$/, '/');
const shot = (name: string) => `${base}screenshots/${name}`;
const source = 'https://github.com/alexcatdad/pr-nanny';
const install = 'brew install --cask alexcatdad/tap/pr-nanny';
const title = 'PR Nanny: your pull requests in the macOS menu bar';
const description =
  'PR Nanny is a small macOS menu bar app that lists the pull requests you opened and the reviews waiting on you, with approval and CI at a glance. It never writes to GitHub.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#EEF0F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17191E" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    <link rel="canonical" href="https://alexcatdad.github.io/pr-nanny/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PR Nanny" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://alexcatdad.github.io/pr-nanny/" />
    <meta property="og:image" content="https://alexcatdad.github.io/pr-nanny/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://alexcatdad.github.io/pr-nanny/og.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="menubar">
      <div class="bar-inner">
        <span class="bar-app">PR Nanny</span>
        <div class="bar-right" aria-hidden="true">
          <span class="bar-side bar-before">
            <svg class="bar-icon" viewBox="0 0 16 16" width="15" height="15"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" /></svg>
            <svg class="bar-icon" viewBox="0 0 16 16" width="15" height="15"><path d="M9.5 1.5 4 9h3.5l-1 5.5L12 7H8.5z" fill="currentColor" /></svg>
          </span>
          <span class="glyph"><img src={`${base}tray-icon.png`} width="18" height="18" alt="" /></span>
          <span class="bar-side bar-after">
            <svg class="bar-icon bar-wifi" viewBox="0 0 18 14" width="17" height="13"><path d="M9 12.6 6.6 10a3.4 3.4 0 0 1 4.8 0zM4.5 7.9a6.4 6.4 0 0 1 9 0l-1.3 1.3a4.6 4.6 0 0 0-6.4 0zM2.3 5.7a9.5 9.5 0 0 1 13.4 0l-1.3 1.3a7.7 7.7 0 0 0-10.8 0z" fill="currentColor" /></svg>
            <svg class="bar-icon bar-battery" viewBox="0 0 26 12" width="25" height="12"><rect x=".75" y=".75" width="21.5" height="10.5" rx="3" fill="none" stroke="currentColor" stroke-opacity=".45" stroke-width="1.5" /><rect x="2.5" y="2.5" width="14" height="7" rx="1.5" fill="currentColor" /><path d="M24 4.2v3.6a1.9 1.9 0 0 0 0-3.6z" fill="currentColor" fill-opacity=".45" /></svg>
            <span class="clock">Sat 7 Nov 09:41</span>
          </span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">PR Nanny keeps your pull requests and review requests in the menu bar.</h1>
          <p class="lede">
            Each one shows whether it is approved and how its checks are doing. It notifies you only after you turn notifications on, and it never writes to GitHub.
          </p>
          <div class="command">
            <code id="install-command">{install}</code>
            <button type="button" class="copy" data-copy="install-command" hidden>Copy</button>
          </div>
          <p class="fine">Free and open source. macOS 13 or later on Apple silicon.</p>
        </div>
        <figure class="hero-panel">
          <picture>
            <source srcset={shot('panel-dark.png')} media="(prefers-color-scheme: dark)" />
            <img
              src={shot('panel-light.png')}
              width="404"
              height="685"
              fetchpriority="high"
              alt="The PR Nanny panel, connected and updated just now. Three pull requests you opened, two waiting on your review and one merged a moment ago, each with its repository, number, age, title, approval and CI status, and a bell."
            />
          </picture>
        </figure>
      </section>

      <div class="column">
        <section aria-labelledby="panel-title">
          <h2 id="panel-title">What the panel tells you</h2>
          <p>
            The header says whether PR Nanny is connected, which account it uses and when it last checked GitHub. It checks every 60 seconds by default; the refresh button checks now.
          </p>
          <p>
            Below that are your open pull requests: the ones you opened, the ones where your review or your team’s review is requested, and anything that merged or closed in the last minute. Show all keeps them in one list, grouped into those three sections. Tabs gives each group its own tab with a count. Click a pull request to open it on GitHub.
          </p>
          <p>
            Each row has two dots. The first is approval: green when at least one current review approves it, grey when none does. The second is CI: green for passed, orange while checks are running, red when they did not pass, and grey when GitHub has no result to give. Missing or incomplete results are never shown as failures.
          </p>
          <p>
            The bell at the end of a row decides whether that pull request may notify you. Bells start off. Review requests do not need one.
          </p>
          <figure class="shot shot-tabs">
            <picture>
              <source srcset={shot('panel-tabs-dark.png')} media="(prefers-color-scheme: dark)" />
              <img
                src={shot('panel-tabs-light.png')}
                width="404"
                height="475"
                loading="lazy"
                alt="The panel in the Tabs layout with Authored 3, Review 2 and Recent 1 tabs. The Authored tab lists three pull requests: one approved and passed, one running and one that did not pass."
              />
            </picture>
          </figure>
        </section>

        <section aria-labelledby="settings-title">
          <h2 id="settings-title">Settings</h2>
          <p>
            Notifications are off until you turn on Allow notifications; macOS asks for permission at that moment. They stay silent unless you also turn on Play a sound. You choose which changes notify you: CI status, approval, review requests, merged and closed. Settings also connects your GitHub account, sets how often PR Nanny checks, and turns on Launch at login.
          </p>
          <figure class="shot shot-settings">
            <picture>
              <source srcset={shot('settings-dark.png')} media="(prefers-color-scheme: dark)" />
              <img
                src={shot('settings-light.png')}
                width="524"
                height="1086"
                loading="lazy"
                alt="The PR Nanny Settings window: GitHub account connected through the GitHub CLI, check every 60 seconds, Allow notifications and Play a sound both off, the five notification events, Launch at login off, and the About section."
              />
            </picture>
          </figure>
        </section>

        <section aria-labelledby="install-title">
          <h2 id="install-title">Install</h2>
          <ol class="steps">
            <li>
              Install it with Homebrew:
              <pre><code>{install}</code></pre>
            </li>
            <li>Open PR Nanny from Applications. It has no Dock icon; its shield with a check mark appears in the menu bar.</li>
            <li>
              Open Settings from the panel and connect GitHub. Connect GitHub CLI reuses the session from <code>gh auth login</code>. Or paste a personal access token; PR Nanny checks it and keeps it in your macOS Keychain. The <a href={`${source}#authentication-and-permissions`}>README lists the read-only permissions</a> a fine-grained token needs.
            </li>
            <li>If you want notifications, turn on Allow notifications and allow them when macOS asks.</li>
          </ol>
          <p>
            PR Nanny needs macOS 13 or later on an Apple silicon Mac. It is signed with a Developer ID and notarised by Apple. To upgrade, run <code>brew upgrade --cask pr-nanny</code>. Releases are also on <a href={`${source}/releases`}>GitHub</a>.
          </p>
        </section>

        <section aria-labelledby="privacy-title">
          <h2 id="privacy-title">What it never does</h2>
          <p>
            PR Nanny only reads. It never comments, approves, merges or changes your notification subscriptions on GitHub.
          </p>
          <p>
            It sends no analytics or telemetry and talks to no server except GitHub’s API. Pull request data stays in memory. A personal access token is kept in a Keychain item only PR Nanny can read, never in a plain file; a GitHub CLI token is read from <code>gh</code> when needed and not copied.
          </p>
        </section>
      </div>
    </main>

    <footer class="column footer">
      <h2 class="family-title">More small menu bar apps</h2>
      <ul class="family">
        <li>
          <a href="https://alexcatdad.github.io/paw-proxy/">
            <img src="https://alexcatdad.github.io/paw-proxy/apple-touch-icon.png" width="32" height="32" alt="" loading="lazy" />
            <span>Paw Proxy</span>
          </a>
          <span class="family-line">Local HTTPS for your dev servers, started with <code>up</code>.</span>
        </li>
        <li>
          <a href="https://alexcatdad.github.io/usb-boop/">
            <img src="https://alexcatdad.github.io/usb-boop/icon.png" width="32" height="32" alt="" loading="lazy" />
            <span>usb-boop</span>
          </a>
          <span class="family-line">Shows the link speed of each USB device you plug in.</span>
        </li>
      </ul>
      <p class="legal">
        <a href={source}>PR Nanny on GitHub</a>. Released under the <a href={`${source}/blob/main/LICENSE`}>MIT licence</a>.
      </p>
    </footer>

    <script is:inline>
      for (const button of document.querySelectorAll('[data-copy]')) {
        if (!navigator.clipboard) continue;
        button.hidden = false;
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy).textContent;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Copy failed';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1600);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --paper: #eef0f3;
    --surface: #f8f9fb;
    --ink: #15171c;
    --muted: #5b6270;
    --hairline: #d4d8df;
    --accent: #4f9a57;
    --accent-ink: #2f6e37;
    --on-accent: #ffffff;
    --bar: rgb(248 249 251 / 72%);
    --bar-ink: #15171c;
    --glyph-filter: none;
    --display: 'Bricolage Grotesque', -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    --text: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    --mono: ui-monospace, 'SF Mono', Menlo, monospace;
    --panel-width: 404px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #17191e;
      --surface: #20232a;
      --ink: #eceef2;
      --muted: #9aa1ae;
      --hairline: #2e323b;
      --accent: #6dba74;
      --accent-ink: #6dba74;
      --on-accent: #10140f;
      --bar: rgb(32 35 42 / 78%);
      --bar-ink: #eceef2;
      --glyph-filter: invert(1);
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 17px/1.55 var(--text);
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, p, figure, pre, ol, ul { margin: 0; }
  a { color: var(--accent-ink); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  code { font: 0.88em/1.4 var(--mono); }
  img { max-width: 100%; height: auto; }
</style>

<style>
  /* Menu bar strip: the one bold thing. */
  .menubar {
    position: relative;
    z-index: 2;
    height: 28px;
    background: var(--bar);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--hairline);
    color: var(--bar-ink);
    font: 500 13px/28px var(--text);
  }
  .bar-inner,
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--panel-width);
    column-gap: 64px;
    width: min(100% - 32px, 1120px);
    margin-inline: auto;
  }
  .bar-app { font-weight: 700; }
  .bar-right {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 28px;
  }
  .bar-side { display: flex; align-items: center; height: 28px; }
  .bar-before { justify-content: flex-end; gap: 14px; padding-right: 12px; }
  .bar-after { justify-content: space-between; padding-left: 12px; gap: 12px; }
  .bar-icon { display: block; opacity: 0.85; }
  .clock { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .glyph {
    display: grid;
    place-items: center;
    width: 32px;
    height: 22px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .glyph img { display: block; width: 18px; height: 18px; filter: var(--glyph-filter); }

  /* Hero: copy left, the panel hanging under the glyph. */
  .hero { align-items: start; padding-bottom: 72px; }
  .hero-copy { padding-top: 88px; min-width: 0; }
  h1 {
    font: 700 64px/1.02 var(--display);
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 14ch;
  }
  .lede { margin-top: 24px; font-size: 21px; line-height: 1.45; color: var(--muted); max-width: 34em; }
  .command {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
    max-width: 34em;
    padding: 10px 10px 10px 18px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
  }
  .command code { flex: 1; min-width: 0; font-size: 15px; overflow-wrap: anywhere; }
  .copy {
    flex: none;
    padding: 7px 14px;
    border: 0;
    border-radius: 7px;
    background: var(--accent);
    color: var(--on-accent);
    font: 600 14px/1.2 var(--text);
    cursor: pointer;
  }
  .copy:hover { filter: brightness(1.06); }
  .fine { margin-top: 14px; font-size: 15px; color: var(--muted); }
  /* The PNG carries a 32pt transparent margin; pull it up so the card sits just under the bar. */
  .hero-panel { margin-top: -26px; animation: drop 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both; }
  .hero-panel img { display: block; width: var(--panel-width); }
  @keyframes drop {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }

  /* Everything below: one quiet column. */
  .column { width: min(100% - 32px, 1120px); margin-inline: auto; }
  .column > * { max-width: 68ch; }
  .column section { padding-top: 64px; }
  .column section + section { margin-top: 24px; border-top: 1px solid var(--hairline); }
  h2 { font: 700 28px/1.2 var(--display); letter-spacing: -0.01em; margin-bottom: 18px; }
  .column section p + p { margin-top: 14px; }
  .column section p { max-width: 68ch; }
  .shot { margin: 28px 0 0 -32px; }
  .shot img { display: block; }
  .shot-settings img { width: 440px; }
  .steps { padding-left: 1.4em; display: grid; gap: 14px; margin-bottom: 18px; }
  .steps li { min-width: 0; }
  .steps li::marker { color: var(--muted); font-variant-numeric: tabular-nums; }
  pre {
    margin-top: 8px;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    overflow-x: auto;
  }
  pre code { font-size: 15px; }

  .footer { margin-top: 80px; padding: 40px 0 56px; border-top: 1px solid var(--hairline); }
  .family-title { font-size: 21px; margin-bottom: 16px; }
  .family { list-style: none; padding: 0; display: grid; gap: 14px; }
  .family li { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: center; }
  .family a { display: contents; font-weight: 600; }
  .family img { grid-row: span 2; border-radius: 8px; }
  .family a span { grid-column: 2; }
  .family-line { grid-column: 2; color: var(--muted); font-size: 15px; }
  .legal { margin-top: 36px; font-size: 15px; color: var(--muted); }

  @media (max-width: 1000px) {
    .bar-inner, .hero { column-gap: 40px; }
    h1 { font-size: 44px; }
  }
  @media (max-width: 760px) {
    .bar-inner { grid-template-columns: auto 1fr; column-gap: 12px; }
    .bar-right { display: flex; justify-content: flex-end; gap: 12px; }
    .bar-before { display: none; }
    .bar-after { padding-left: 0; }
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero-panel { order: -1; margin: -26px auto 0; width: min(100%, var(--panel-width)); }
    .hero-panel img { width: 100%; }
    .hero { padding-bottom: 24px; }
    .hero-copy { padding-top: 16px; }
    h1 { font-size: 44px; }
    .lede { font-size: 19px; }
    .shot { margin-left: -16px; margin-right: -16px; }
    .shot-tabs img, .shot-settings img { width: min(100%, 440px); }
  }
  @media (max-width: 420px) {
    .bar-wifi { display: none; }
    h1 { font-size: 36px; }
    .command { flex-wrap: wrap; }
    .command code { flex-basis: 100%; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-panel { animation: none; }
  }
</style>
