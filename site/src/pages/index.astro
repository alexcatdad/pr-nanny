---
import download from '../release.json';
const base = `${import.meta.env.BASE_URL}/`;
const releases = 'https://github.com/alexcatdad/pr-nanny/releases';
const downloadBase = `https://github.com/alexcatdad/pr-nanny/releases/download/v${download.version}/pr-nanny-${download.version}`;
const macDownload = `${downloadBase}-${download.macos}`;
const windowsDownload = `${downloadBase}-${download.windows}`;
const source = 'https://github.com/alexcatdad/pr-nanny';
const contributing = `${source}/blob/main/CONTRIBUTING.md`;
const title = 'PR Nanny — Your pull requests, quietly in view';
const description = 'A small native tray app for authored PRs and reviews waiting on you. Read-only, local, and open source.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2ea44f" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="canonical" href="https://alexcatdad.github.io/pr-nanny/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PR Nanny" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://alexcatdad.github.io/pr-nanny/" />
    <meta property="og:image" content="https://alexcatdad.github.io/pr-nanny/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://alexcatdad.github.io/pr-nanny/og.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="top">
      <a class="brand" href={base} aria-label="PR Nanny home">
        <img src={`${base}icon.png`} width="34" height="34" alt="" />
        <span>PR Nanny</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#install">Install</a>
        <a href="#privacy">Privacy</a>
        <a href={source} target="_blank" rel="noreferrer">Source</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Somebody should keep an eye on your pull requests.</h1>
          <p class="lede">PR Nanny lives in your system tray. It watches the PRs you opened and the reviews waiting on you, shows approval and CI at a glance, and rings only when you ask it to. It never writes to GitHub.</p>
          <div class="actions">
            <a class="button" href={macDownload}>Download for macOS</a>
            <a class="button" href={windowsDownload}>Download for Windows</a>
            <a class="plain" href="#install">Installation instructions</a>
          </div>
          <p class="fine">macOS 13+ on Apple Silicon, Windows 10/11 x64, Linux x64.</p>
        </div>

        <div class="desk" aria-label="PR Nanny in the system tray">
          <div class="menubar" aria-hidden="true">
            <span class="menubar-gap"></span>
            <img class="tray" src={`${base}tray.png`} width="22" height="22" alt="" />
            <span class="clock">Tue 14:08</span>
          </div>
          <figure class="popup">
            <picture>
              <source srcset={`${base}screenshots/popup-dark-tabs.png`} media="(prefers-color-scheme: dark)" />
              <img src={`${base}screenshots/popup-light-tabs.png`} width="460" height="420" alt="The PR Nanny popup with Yours, Review and Recent tabs. Each pull request shows its approval and CI status and a bell toggle." fetchpriority="high" />
            </picture>
          </figure>
          <div class="toast" role="img" aria-label="Example notification: review requested on alexcatdad/infra #103">
            <img src={`${base}icon.png`} width="36" height="36" alt="" />
            <div>
              <strong>Review requested</strong>
              <span>alexcatdad/infra #103</span>
              <span>Unknown checks stay informational</span>
            </div>
          </div>
        </div>
      </section>

      <section class="notes" aria-label="What PR Nanny does">
        <p><strong>Yours, and what you owe.</strong> Your open PRs, reviews requested from you or your teams, and for a minute after they close, the ones that just merged. Group them with Tabs or keep one list with Show all.</p>
        <p><strong>Quiet until you say so.</strong> Review requests can notify you. For any other PR, switch on its bell. Notifications come from your machine and nothing else.</p>
        <p id="privacy"><strong>Read-only, local.</strong> PR Nanny never changes subscriptions or sends analytics. Your PR data stays in memory and your token stays in your system keychain.</p>
      </section>

      <section class="install" id="install" aria-labelledby="install-title">
        <h2 id="install-title">Install</h2>
        <p class="sub">PR Nanny is a prerelease. Builds and checksums are listed with each <a href={releases} target="_blank" rel="noreferrer">release</a>.</p>
        <div class="platforms">
          <article>
            <h3>macOS</h3>
            <a class="plain" href={macDownload}>Download {download.installers ? 'DMG' : 'ZIP'} · Apple Silicon</a>
            <p>macOS 13 or newer. {download.installers ? 'Open the DMG and drag PR Nanny onto Applications. Eject the image, then open PR Nanny from Applications.' : 'Unzip the download and move PR Nanny.app to Applications.'}</p>
            <p>Developer ID signed and notarised by Apple. No Homebrew required.</p>
          </article>
          <article>
            <h3>Windows</h3>
            <a class="plain" href={windowsDownload}>Download {download.installers ? 'Setup.exe' : 'ZIP'} · Windows x64</a>
            <p>Windows 10/11 x64. {download.installers ? 'Run Setup, then open PR Nanny from the Start Menu. Setup installs WebView2 if needed.' : 'Unzip the archive and run pr-nanny.exe. WebView2 Runtime is required.'}</p>
            <p>The Windows build is unsigned and may show a publisher warning.</p>
          </article>
          <article>
            <h3>Linux</h3>
            <p>x64 with glibc 2.39+, GTK4, WebKitGTK 6, and a Secret Service-compatible credential store.</p>
            <p>Run <code>./install.sh</code> from the extracted archive and make sure <code>~/.local/bin</code> is on your <code>PATH</code>.</p>
          </article>
        </div>
        <div class="brew">
          <div>
            <h3>Homebrew on macOS</h3>
            <pre><code>brew tap alexcatdad/tap
brew install --cask alexcatdad/tap/pr-nanny</code></pre>
          </div>
          <div>
            <h3>Homebrew on Linux</h3>
            <pre><code>brew tap alexcatdad/tap
brew install alexcatdad/tap/pr-nanny</code></pre>
          </div>
        </div>
        <p class="fine">Homebrew is optional. Homebrew on Windows installs the Linux app in WSL; use the Windows download above for the native app. <a href="https://github.com/alexcatdad/pr-nanny/blob/main/build/README.md" target="_blank" rel="noreferrer">Homebrew notes</a></p>
        <p class="fine">A build working on one platform does not mean the others are qualified.</p>
      </section>
    </main>

    <footer class="bottom">
      <span>PR Nanny is open source under the MIT license.</span>
      <nav aria-label="Footer navigation">
        <a href={source} target="_blank" rel="noreferrer">Source</a>
        <a href={releases} target="_blank" rel="noreferrer">Releases</a>
        <a href={contributing} target="_blank" rel="noreferrer">Contributing</a>
        <a href={`${source}/blob/main/SECURITY.md`} target="_blank" rel="noreferrer">Security</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  /* Layout: wide serif headline left, a staged desktop right where the tray icon rings once and a notification arrives. Everything below is quiet prose. */
  :global(:root) {
    color-scheme: light dark;
    --ground: light-dark(#f2f5f3, #0e1311);
    --ink: light-dark(#14211b, #e8efeb);
    --muted: light-dark(#4d5d55, #a3b2aa);
    --line: light-dark(#cfd9d3, #26332d);
    --bell: light-dark(#1a7f37, #3fb950);
    --desk-a: light-dark(#cfe3d6, #1b2a22);
    --desk-b: light-dark(#a9c3b5, #0f1a14);
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
    --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 1.5rem; }
  :global(body) { margin: 0; font: 1.0625rem/1.65 var(--sans); background: var(--ground); color: var(--ink); -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; }
  :global(a:focus-visible) { outline: 2px solid var(--bell); outline-offset: 3px; border-radius: 3px; }
  h1, h2, h3, p, figure, pre { margin: 0; }
  .top, main, .bottom { width: min(100% - 40px, 1160px); margin-inline: auto; }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding: 22px 0; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: .95rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: center; padding: 48px 0 88px; }
  .hero > * { min-width: 0; }
  h1 { font: 500 clamp(2.4rem, 5.2vw, 4.1rem)/1.04 var(--serif); letter-spacing: -.02em; text-wrap: balance; }
  .lede { margin-top: 24px; font-size: 1.15rem; color: var(--muted); max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 32px; }
  .button { background: var(--bell); color: light-dark(#fff, #07130b); padding: 12px 22px; border-radius: 999px; font-weight: 650; text-decoration: none; }
  .button:hover { filter: brightness(1.08); }
  .plain { font-weight: 560; text-underline-offset: 4px; }
  .fine { margin-top: 20px; font-size: .9rem; color: var(--muted); max-width: 62ch; }

  .desk { position: relative; border-radius: 18px; background: linear-gradient(155deg, var(--desk-a), var(--desk-b)); aspect-ratio: 1 / 1.04; overflow: hidden; }
  .menubar { display: flex; align-items: center; gap: 14px; height: 30px; padding: 0 14px; background: rgb(15 20 18 / 72%); color: #f2f6f4; font-size: .78rem; justify-content: flex-end; }
  .menubar-gap { flex: 1; }
  .tray { filter: invert(1); transform-origin: 50% 8%; animation: ring 1.3s ease-in-out .9s 1 both; }
  .popup { position: absolute; top: 40px; right: 6%; width: 82%; }
  .popup::before { content: ""; position: absolute; top: -6px; right: 24px; width: 12px; height: 12px; background: Canvas; transform: rotate(45deg); border-radius: 2px; }
  .popup img { position: relative; display: block; width: 100%; height: auto; border-radius: 12px; box-shadow: 0 24px 60px rgb(0 0 0 / 32%); }
  .toast { position: absolute; left: 5%; bottom: 7%; display: flex; gap: 12px; align-items: flex-start; width: min(78%, 330px); padding: 12px 14px; border-radius: 14px; background: light-dark(rgb(255 255 255 / 92%), rgb(32 38 35 / 92%)); box-shadow: 0 14px 40px rgb(0 0 0 / 30%); font-size: .82rem; line-height: 1.4; animation: arrive .6s cubic-bezier(.2, .8, .2, 1) 1.1s both; }
  .toast div { display: grid; min-width: 0; }
  .toast strong { font-weight: 650; }
  .toast span { color: var(--muted); overflow-wrap: anywhere; }
  @keyframes ring { 0%, 100% { transform: rotate(0); } 15% { transform: rotate(16deg); } 30% { transform: rotate(-13deg); } 45% { transform: rotate(9deg); } 60% { transform: rotate(-6deg); } 75% { transform: rotate(3deg); } }
  @keyframes arrive { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

  .notes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; padding: 56px 0; border-top: 1px solid var(--line); }
  .notes p { color: var(--muted); max-width: 42ch; }
  .notes strong { display: block; margin-bottom: 6px; font: 500 1.4rem/1.2 var(--serif); color: var(--ink); }
  .install { padding: 56px 0 80px; border-top: 1px solid var(--line); }
  h2 { font: 500 clamp(1.8rem, 3vw, 2.4rem)/1.1 var(--serif); letter-spacing: -.01em; }
  .sub { margin-top: 10px; color: var(--muted); }
  .brew { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 28px; }
  .brew > *, .platforms > * { min-width: 0; }
  h3 { font-size: 1rem; font-weight: 650; }
  pre { margin-top: 8px; padding: 16px 18px; background: light-dark(#e3ebe6, #17201b); border-radius: 10px; overflow-x: auto; }
  code { font: .86em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  pre code { font-size: .88rem; line-height: 1.75; }
  .platforms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-top: 48px; }
  .platforms p { margin-top: 8px; color: var(--muted); font-size: .96rem; }
  .bottom { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; padding: 24px 0 44px; border-top: 1px solid var(--line); font-size: .9rem; color: var(--muted); }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 24px; }
    .desk { max-width: 560px; }
    .notes, .brew, .platforms { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
  @media (max-width: 480px) { nav { gap: 8px 16px; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .tray, .toast { animation: none; }
  }
</style>
