<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release app only, and only together with the Developer ID provisioning
  profile that authorizes these restricted entitlements (package-app.sh
  PROVISIONING_PROFILE). They give the app the data-protection keychain and the
  team access group it stores the GitHub token in.
-->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>CX6D6KGCT5.com.alexcatdad.pr-nanny</string>
	<key>com.apple.developer.team-identifier</key>
	<string>CX6D6KGCT5</string>
	<key>keychain-access-groups</key>
	<array>
		<string>CX6D6KGCT5.com.alexcatdad.pr-nanny</string>
	</array>
</dict>
</plist>
